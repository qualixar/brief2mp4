{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "character.schema.json",
  "title": "brief2mp4 character",
  "description": "A rigged 2D character: parts with pivots and parent links, a palette, proportions and an id. Every part is drawn in one rest-pose coordinate system with the feet at y = 0 and the character facing +x; a part's pivot is where it hinges, in that same system.",
  "type": "object",
  "required": ["id", "palette", "proportions", "parts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["biped", "bird", "object"] },
    "version": { "type": "integer", "minimum": 1 },
    "blink": { "type": "boolean" },
    "palette": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
    },
    "proportions": {
      "type": "object",
      "required": ["height", "legLength"],
      "additionalProperties": false,
      "properties": {
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "legLength": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "poseOverrides": { "type": "object", "additionalProperties": { "type": "object" } },
    "parts": { "type": "array", "minItems": 8, "items": { "$ref": "#/$defs/part" } }
  },
  "$defs": {
    "point": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } },
    "part": {
      "type": "object",
      "required": ["id", "parent", "pivot", "z", "shapes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "parent": { "type": ["string", "null"] },
        "pivot": { "$ref": "#/$defs/point" },
        "z": { "type": "number" },
        "sign": { "enum": [-1, 1] },
        "prop": { "type": "boolean" },
        "mouth": { "$ref": "#/$defs/mouth" },
        "shapes": { "type": "array", "items": { "$ref": "#/$defs/shape" } }
      }
    },
    "mouth": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["lips", "jaw"] },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "maxOpen": { "type": "number", "minimum": 0, "maximum": 80 }
      }
    },
    "shape": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["path", "ellipse", "circle", "capsule", "rect", "poly"] },
        "d": { "type": "string", "pattern": "^[MLCQZ0-9eE+\\-., ]+$" },
        "c": { "$ref": "#/$defs/point" },
        "r": { "type": ["number", "array"] },
        "rot": { "type": "number" },
        "a": { "$ref": "#/$defs/point" },
        "b": { "$ref": "#/$defs/point" },
        "ra": { "type": "number", "exclusiveMinimum": 0 },
        "rb": { "type": "number", "exclusiveMinimum": 0 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 },
        "pts": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } },
        "smooth": { "type": "boolean" },
        "closed": { "type": "boolean" },
        "fill": { "type": ["string", "null"] },
        "stroke": { "type": ["string", "null"] },
        "sw": { "type": "number", "exclusiveMinimum": 0 },
        "role": { "enum": ["base", "detail", "hole", "line", "mouth"] },
        "shade": { "type": "boolean" }
      }
    }
  }
}
